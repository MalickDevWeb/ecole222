# ==========================================
# École 221 - Environment Configuration Template
# ==========================================

# Server Port
PORT=8090

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=jdbc:postgresql://your-neon-host.c-11.us-east-1.aws.neon.tech/221-db?sslmode=require&channelBinding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_db_password_here

# Redis Cache / Session (Upstash)
REDIS_URL=rediss://default:your_redis_token@your-redis-host.upstash.io:6379

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# JWT Security (Must be at least 32 characters)
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long

# AI Provider (mock, gemini, mistral)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key

# Email Provider (mock, brevo)
EMAIL_PROVIDER=mock
BREVO_API_KEY=your_brevo_api_key
